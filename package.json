{
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/functions-framework": "^5.0.5",
    "dotenv": "^18.0.8",
    "googleapis": "^186.0.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "start": "functions-framework --target=gmailPubSubHandler",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run format && npm run lint:fix",
    "validate": "npm run format:check && npm run lint && npm run test",
    "validate:fix": "npm run fix && npm run test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-watchman",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-watchman --coverage",
    "test:connectivity": "node connectivity-check.js"
  }
}
